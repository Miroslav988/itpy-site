          "text": "x",
          "italic": true
        },
        {
          "text": " & 41 = 0 → "
        },
        {
          "text": "x",
          "italic": true
        },
        {
          "text": " & "
        },
        {
          "text": "А",
          "italic": true
        },
        {
          "text": " = 0)"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "тождественно истинна (т. е. принимает значение 1 при любом неотрицательном целом значении переменной "
        },
        {
          "text": "x",
          "italic": true
        },
        {
          "text": ")?"
        }
      ]
    },
    {
      "type": "heading",
      "level": 3,
      "text": "Решение"
    },
    {
      "type": "image",
      "src": "/blog/zadanie-15-ege-razbor-zadachi-34521/02.webp",
      "width": 750,
      "height": 506,
      "alt": "Вариант 1: классическое решение через переменную True",
      "caption": "Вариант 1: классическое решение через переменную True"
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "# Код решения Вариант 1\n"
        },
        {
          "text": "def F(x, A):",
          "bold": true
        },
        {
          "text": "\n"
        },
        {
          "text": "    return (x & 51 == 0) or ((x & 41 == 0) <= (x & A == 0))",
          "bold": true
        },
        {
          "text": "\n\n"
        },
        {
          "text": "R = []",
          "bold": true
        },
        {
          "text": "\n"
        },
        {
          "text": "for A in range(0, 1000):",
          "bold": true
        },
        {
          "text": "\n"
        },
        {
          "text": "    flag = True",
          "bold": true
        },
        {
          "text": "\n"
        },
        {
          "text": "    for x in range(0, 1000):",
          "bold": true
        },
        {
          "text": "\n"
        },
        {
          "text": "        if F(x, A) == False:",
          "bold": true
        },
        {
          "text": "\n"
        },
        {
          "text": "        flag = False",
          "bold": true
        },
        {
          "text": "\n"
        },
        {
          "text": "        break ",
          "bold": true
        },
        {
          "text": "\n"
        },
        {
          "text": "    if flag == True:",
          "bold": true
        },
        {
          "text": "\n"
        },
        {
          "text": "        R.append(A)",
          "bold": true
        },
        {
          "text": "\n"
        },
        {
          "text": "print(max(R))",
          "bold": true
        }
      ]
    },
