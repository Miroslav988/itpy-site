    {
      "type": "quote",
      "content": [
        {
          "text": "for n in range(1, 1000):\n    x = n\n    M = []\n    while x > 0:\n        M.append(x % 2)\n        x //= 2\n    M.reverse()\n\n    if len(M) % 2 == 0:\n        M = M[:len(M)//2] + [1, 1, 1] + M[len(M)//2:]\n    else:\n        M = [1, 1] + M[2:] + [1]\n\n    r = 0\n    M.reverse()\n    for i in range(0, len(M)):\n        r += M[i] * 2 ** i\n\n    if r > 4000:\n        print(n)\n        break"
        }
      ]
