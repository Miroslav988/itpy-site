          }
        ],
        [
          {
            "text": "for a1 in M: ",
            "bold": true
          },
          {
            "text": "- Перебираем все варианты для переменной"
          },
          {
            "text": " a1",
            "bold": true
          },
          {
            "text": " (начало отрезка "
          },
          {
            "text": "A",
            "bold": true
          },
          {
            "text": ")."
          }
        ],
        [
          {
            "text": "for a2 in M: ",
            "bold": true
          },
          {
            "text": "- Перебираем все варианты для переменной "
          },
          {
            "text": "a2",
            "bold": true
          },
          {
            "text": " (конец отрезка "
          },
          {
            "text": "A",
            "bold": true
          },
          {
            "text": ")."
          }
        ],
        [
          {
            "text": "if all(F(x, a1, a2) for x in M): ",
