          "text": "import itertools\ns = open('24.txt').readline()\nM = []\nmaxi = 0\nfor i in itertools.product('ABC', repeat = 3):\n    r = ''.join(i)\n    M.append(r)\nfor x in M:\n    s = s.replace(x, ' ')\nmaxi = max([len(i) for i in s.split()])\nprint(maxi+3)"
