        ],
        [
          {
            "text": "graph = 'АБ БА АИ ИА ИБ БИ ИЖ ЖИ БЖ ЖБ БВ ВБ ВЖ ЖВ ВГ ГВ ЖЕ ЕЖ ЕГ ГЕ ДГ ГД ЕД ДЕ'",
            "bold": true
          },
          {
            "text": " - Аналогично делаем для графа с буквенными вершинами."
          }
        ],
        [
          {
            "text": "for per in permutations('АБВГДЖИЕ'):",
            "bold": true
          },
          {
            "text": " - Через "
          },
          {
            "text": "permutations",
            "bold": true
          },
          {
            "text": " получаем все возможные перестановки символов "
          },
          {
            "text": "'АБВГДЖИЕ'",
            "bold": true
          },
          {
            "text": "."
          }
        ],
        [
          {
            "text": "new_table = table ",
            "bold": true
          },
          {
            "text": "- Инициализируем переменную "
          },
          {
            "text": "new_table",
