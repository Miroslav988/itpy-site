      "alt": "-2"
    },
    {
      "type": "quote",
      "content": [
        {
          "text": "def Divisors(x):\n    divisors = set()\n    for j in range(1, int(x**0.5)+1):\n        if x % j == 0:\n            divisors.add(j)\n            divisors.add(x // j)\n    return sorted(divisors)\n\nfrom fnmatch import *\nfor x in range(53, 10**7, 53):\n    if fnmatch(str(x), '*2?2*'):\n        if str(x) == str(x)[::-1]:  \n            if x % 53 == 0:  \n                diviors = Divisors(x)\n                if len(diviors) > 30:\n                    print(x, sum(diviors))"
        }
      ]
    },
