      "type": "heading",
      "level": 3,
      "text": "👩‍💻 Код решения"
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "from ipaddress import *\nR = []\nfor mask in range(32+1):\n    net1 = ip_network(f'121.171.5.70/{mask}', 0)\n    net2 = ip_network(f'121.171.5.107/{mask}', 0)\n    if net1 == net2:\n        R.append(net1.num_addresses)\nprint(min(R))"
