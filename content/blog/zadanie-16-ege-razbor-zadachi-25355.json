      "items": [
        [
          {
            "text": "from functools import *",
            "code": true
          },
          {
            "text": "\nИмпортируем инструменты из functools (в т.ч. lru_cache)."
          }
        ],
        [
          {
            "text": "def F(n):",
            "code": true
          },
          {
            "text": "\nОпределяем функцию F, принимает целое число n."
          }
        ],
        [
          {
            "text": "if n >= 19:",
            "code": true
          },
          {
            "text": "\nПроверяем ветку для больших n (база/переход для рекурсии в F)."
          }
        ],
        [
          {
            "text": "return F(n - 4) + 3580",
            "code": true
          },
          {
            "text": "\nРекурсивно уменьшаем n на 4 и прибавляем 3580 к результату."
          }
        ],
        [
          {
            "text": "else:",
            "code": true
          },
          {
            "text": "\nВетка для случая, когда n < 19."
          }
        ],
        [
          {
            "text": "return 6 * (G(n - 7) - 36)",
            "code": true
          },
          {
            "text": "\nВызываем G(n-7), вычитаем 36, умножаем итог на 6 и возвращаем."
          }
        ],
        [
          {
            "text": "@lru_cache()",
            "code": true
          },
          {
            "text": "\nВключаем кэширование результатов G(n), чтобы ускорить повторные вызовы."
          }
        ],
        [
          {
            "text": "def G(n):",
            "code": true
          },
          {
            "text": "\nОпределяем функцию G, принимает целое число n."
          }
        ],
        [
          {
            "text": "if n >= 248045:",
            "code": true
          },
          {
            "text": "\nПроверяем базовый случай: при больших n рекурсия в G останавливается."
          }
        ],
        [
          {
            "text": "return n / 20 + 28",
            "code": true
          },
          {
            "text": "\nВозвращаем значение по формуле для базового случая G."
          }
        ],
        [
          {
            "text": "else:",
            "code": true
          },
          {
            "text": "\nВетка для случая, когда n < 248045."
          }
        ],
        [
          {
            "text": "return G(n + 9) - 4",
            "code": true
          },
          {
            "text": "\nРекурсивно увеличиваем n на 9 и вычитаем 4 из результата."
          }
        ],
        [
          {
            "text": "for i in range(248045, 0, -1):",
            "code": true
          },
          {
            "text": "\nЦикл перебирает i от 248045 до 1 с шагом -1."
          }
        ],
        [
          {
            "text": "G(i)",
            "code": true
          },
          {
            "text": "\nЗаполняем кэш значениями G(i) для всех i в этом диапазоне."
          }
        ],
        [
          {
            "text": "print(F(673))",
