    {
      "type": "paragraph",
      "content": [
        {
          "text": "Комментарии к коду решения:",
          "bold": true
        }
      ]
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        [
          {
            "text": "def F(a, b, s: str):",
            "bold": true
          },
          {
            "text": " - объявление функции "
          },
          {
            "text": "F",
            "bold": true
          },
          {
            "text": " с "
          },
          {
            "text": "тремя параметрами: a и b (целые числа) и s (строка)",
            "bold": true
          },
          {
            "text": "."
          }
        ],
        [
          {
            "text": "if a >= b or a == 28:",
            "bold": true
          },
          {
            "text": " - проверка условия. Если "
          },
          {
            "text": "a больше или равно b",
            "bold": true
          },
          {
            "text": " или"
          },
          {
            "text": " a равно 28",
            "bold": true
          },
          {
            "text": ", то выполняется следующий блок кода."
          }
        ],
        [
          {
            "text": "return a == b and 'BACA' not in s",
            "bold": true
          },
          {
            "text": " - возвращается результат проверки двух условий: "
          },
          {
            "text": "a",
            "bold": true
          },
          {
            "text": " равно "
          },
          {
            "text": "b",
            "bold": true
          },
          {
            "text": " и строка "
          },
          {
            "text": "'BACA'",
            "bold": true
          },
          {
            "text": " не содержится в переменной "
          },
          {
            "text": "s",
            "bold": true
          },
          {
            "text": "."
          }
        ],
        [
          {
            "text": "return F(a+2, b, s+'A') + F(a+3, b, s+'B') + F(a*2, b, s+'C') ",
            "bold": true
          },
          {
            "text": "- возвращается сумма трех рекурсивных вызовов функции "
          },
          {
            "text": "F",
            "bold": true
          },
          {
            "text": ". В каждом вызове значение "
