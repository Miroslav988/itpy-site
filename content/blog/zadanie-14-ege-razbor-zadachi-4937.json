      "caption": "Ответ: 146405"
    },
    {
      "type": "heading",
      "level": 3,
      "text": "Комментарии к коду"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        [
          {
            "text": "def my_int(M: list, n: int):",
            "code": true
          },
          {
            "text": "\nПараметры: M (список чисел) и n (основание системы счисления)."
          }
        ],
        [
          {
            "text": "r = 0",
            "code": true
          },
          {
            "text": "\nСоздается переменная r, которая будет содержать итоговое значение."
          }
        ],
        [
          {
            "text": "M.reverse()",
            "code": true
          },
          {
            "text": "\nИнвертируется список M для удобного вычисления числа."
          }
        ],
        [
          {
            "text": "for i in range(0, len(M)):",
            "code": true
          },
          {
            "text": "\nЗапускается цикл for, перебирающий индексы элементов списка M."
          }
        ],
        [
          {
            "text": "r += M[i] * n ** i",
            "code": true
          },
          {
            "text": "\nК итоговому значению r прибавляется произведение элемента списка M[i] на степень основания n в степени i."
          }
        ],
        [
          {
            "text": "return r",
            "code": true
          },
          {
            "text": "\nФункция возвращает значение r."
          }
        ],
        [
          {
            "text": "R = []",
            "code": true
          },
          {
            "text": "\nСоздается пустой список R, куда будут добавляться результаты."
          }
        ],
        [
          {
            "text": "for x in range(0, 80):",
            "code": true
          },
          {
            "text": "\nЗапускается цикл for, перебирающий значения от 0 до 79 и присваивающий их переменной x."
          }
        ],
        [
          {
            "text": "A = my_int([3, x, 7, 5], 80) + my_int([1, 4, x, 0], 80)",
            "code": true
          },
          {
            "text": "\nВычисляется значение A, равное сумме результатов функции my_int для списков с основанием 80."
          }
        ],
        [
          {
            "text": "if A % 17 == 0:",
            "code": true
          },
          {
            "text": "\nПроверяется, делится ли число A на 17."
          }
        ],
        [
          {
            "text": "R.append(A // 17)",
            "code": true
          },
          {
            "text": "\nЕсли число A делится на 17, результат целочисленного деления A на 17 добавляется в список R."
          }
        ],
        [
          {
            "text": "print(max(R))",
            "code": true
          },
          {
            "text": "\nВыводится наибольший элемент из списка R."
          }
        ]
      ]
    }
