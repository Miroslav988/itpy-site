          }
        ],
        [
          {
            "text": "if n < 2025:",
            "code": true
          },
          {
            "text": "\nПроверка условия: если n меньше 2025."
          }
        ],
        [
          {
            "text": "return n**2",
            "code": true
          },
          {
            "text": "\nВозврат квадрата числа n, если условие из пункта 4 истинно."
          }
        ],
        [
          {
            "text": "if 2025 <= n < 2050:",
            "code": true
          },
          {
            "text": "\nПроверка условия: если n больше либо равно 2025 и меньше 2050."
          }
        ],
        [
          {
            "text": "return 2 * F(n-1) - F(n-2) + n",
            "code": true
          },
          {
            "text": "\nВозврат значения, вычисленного по формуле, если условие из пункта 6 истинно."
          }
        ],
        [
          {
            "text": "if 2050 <= n <= 2100:",
            "code": true
          },
          {
            "text": "\nПроверка условия: если n от 2050 до 2100 включительно."
          }
        ],
        [
          {
            "text": "return F(n-1) + 2 * F(n-2) + 3 * F(n-3)",
            "code": true
          },
          {
            "text": "\nВозврат значения, вычисленного по формуле, если условие из пункта 8 истинно."
          }
        ],
        [
          {
