    {
      "type": "quote",
      "content": [
        {
          "text": "import sys\nsys.setrecursionlimit(10000)\n\ndef F(n):\n    if n > 2024:\n        return n\n    if n <= 2024:\n        return n * F(n + 1)\n\nprint(F(2022) / F(2024))"
        }
      ]
