    {
      "type": "quote",
      "content": [
        {
          "text": "for n in range(1, 1000):\n    M = []\n    x = n\n\n    while x > 0:\n        M.append(x % 5)\n        x //= 5\n    M.reverse()\n\n    if M[-1] % 2 == 0:\n        M.append(2)\n    else:\n        M = [3] + M + [2]\n\n    s = ''.join([str(x) for x in M])\n    r = int(s, 5)\n\n    if r < 1000:\n        print(n)"
        }
