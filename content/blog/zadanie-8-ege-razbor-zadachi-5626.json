            "text": " для работы с итераторами."
          }
        ],
        [
          {
            "text": "count = 0",
            "bold": true
          },
          {
            "text": " - Инициализируем счетчик для счета подходящих чисел."
          }
        ],
        [
          {
            "text": "for s in itertools.product('01234567', repeat=5): ",
            "bold": true
          },
          {
            "text": "- Генерация всех возможных комбинаций длины "
          },
          {
            "text": "5",
            "bold": true
          },
          {
            "text": " из цифр "
          },
          {
            "text": "0-7",
            "bold": true
          },
          {
            "text": " (восьмеричная система счисления) ."
          }
        ],
        [
          {
            "text": "slovo = ''.join(s) -",
            "bold": true
          },
          {
            "text": " Преобразуем кортеж"
          },
          {
            "text": " s",
            "bold": true
          },
          {
            "text": " в строку"
          },
          {
            "text": " slovo",
            "bold": true
          },
          {
            "text": "."
          }
        ],
        [
          {
            "text": "if slovo[0] != '0': ",
            "bold": true
          },
          {
            "text": "- Проверка: если первая цифра не равна"
          },
          {
            "text": " '0'",
            "bold": true
          },
          {
            "text": "."
          }
        ],
        [
          {
            "text": "if slovo[0] not in '1357': ",
            "bold": true
          },
          {
            "text": "- Проверка: если первая цифра не содержится в "
          },
          {
            "text": "'1357'",
            "bold": true
          },
          {
            "text": "."
          }
        ],
        [
          {
            "text": "if slovo[-1] not in '26': ",
            "bold": true
          },
          {
            "text": "- Проверка: если последняя цифра не содержится в "
          },
          {
            "text": "'26'",
            "bold": true
          },
          {
            "text": "."
          }
        ],
        [
          {
            "text": "if slovo.count('7') <= 2: ",
            "bold": true
          },
          {
            "text": "- Проверка: если количество цифр "
          },
          {
            "text": "'7'",
            "bold": true
          },
          {
            "text": " в слове не превышает "
          },
          {
            "text": "2",
            "bold": true
          },
          {
            "text": "."
          }
        ],
        [
          {
            "text": "count += 1",
            "bold": true
          },
          {
            "text": " - При выполнении всех условие, увеличивает счетчик на "
