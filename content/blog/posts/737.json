    },
    {
      "type": "code",
      "text": "cnt = 0\nfor s in open('9.csv'):\n    M = sorted([int(x) for x in s.split(';')])\n    if M[-1] < sum(M[:3]):\n        if len(set(M)) == 3:\n            cnt += 1\nprint(cnt)\n\n# Ответ: 147"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Комментарии к коду"
    },
    {
      "type": "list",
      "ordered": true,
