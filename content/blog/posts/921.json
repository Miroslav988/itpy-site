    {
      "type": "heading",
      "level": 2,
      "text": "Код решения"
    },
    {
      "type": "code",
      "text": "from itertools import *\nn = 0\ncnt = 0\nfor p in product(sorted('АПРЕЛЬ', reverse=True), repeat=5):\n    word = ''.join(p)\n    n += 1\n\n    if word[-1] == 'Ь':\n        cnt += 1\n        print(word)\n\n    if n >= 387:\n        break\n\nprint(cnt)\n\n# Ответ: 65"
    },
