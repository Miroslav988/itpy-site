    {
      "type": "code",
      "text": "cnt = 0\nfor s in open('9.txt'):\n    M = [int(x) for x in s.split()]\n    if len([x for x in M if abs(x) % 10 == 3]) == 3:\n        A = [x for x in M if x > 0]\n        B = [x for x in M if x < 0]\n        if sum(A) ** 2 < sum(B) ** 2:\n            cnt += 1\nprint(cnt)"
    },
