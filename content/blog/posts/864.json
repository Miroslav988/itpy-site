    {
      "type": "code",
      "text": "def F(a, b):\n    if a >= b:\n        return a == b\n    return F(a+1, b) + F(int(f'{a:b}' + f'{a % 5:b}', 2), b)\n\nprint(F(int('1', 2), int('101000101', 2)))\n\n# Ответ: 53669"
