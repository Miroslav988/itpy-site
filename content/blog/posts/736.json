        }
      ]
    },
    {
      "type": "quote",
      "content": [
        {
          "text": "В комментариях оставлю решение через цикл "
        },
        {
          "text": "for.",
          "href": "https://informatikakegeitpy.notion.site/9542-12-31e0d3866b7d4c20bdab91fe6059ae63?pvs=4"
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Код решения"
    },
    {
      "type": "code",
      "text": "from itertools import *\ncnt = 0\nfor per in product('01234567', repeat=5):\n    num = ''.join(per)\n    if num[0] != '0' and num[0] not in '1357':\n        if num[-1] not in '26' and num.count('7') <= 2:\n            cnt += 1\nprint(cnt)\n\n# Ответ: 9135"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Комментарии к коду"
    },
