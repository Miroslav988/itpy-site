    {
      "type": "code",
      "text": "R = []\nfor x in range(1, 2030+1):\n    num = 6**2030 + 6**100 - x\n    s = ''\n    while num > 0:\n        s = str(num % 6) + s\n        num //= 6\n    R.append([s.count('0'), x])\n\nprint(max(R))"
    }
