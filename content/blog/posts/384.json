        },
        {
          "text": " Интересна она благодаря условию: \"После выполнения программы получилась строка, содержащая только "
        },
        {
          "text": "двойки\".",
          "href": "https://informatikakegeitpy.notion.site/9542-12-31e0d3866b7d4c20bdab91fe6059ae63?pvs=4"
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Код решения"
    },
    {
      "type": "code",
      "text": "for n in range(201, 1000):\n    s = '1' * n\n    while '111' in s or '222' in s:\n        s = s.replace('111', '22', 1)\n        s = s.replace('222', '1', 1)\n    if len(s) == s.count('2'):\n        print(n)\n        break"
    }
  ],
