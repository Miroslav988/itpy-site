      "text": "Код решения"
    },
    {
      "type": "code",
      "text": "s = open('0. files/24.txt').readline()\ns = s.split('FSRQ')\nmaxi = 0\nfor i in range(len(s)-80):\n    r = 'SRQ' + 'FSRQ'.join(s[i:i+81]) + 'FSR'\n    maxi = max(maxi, len(r))\nprint(maxi)"
    },
