        {
          "text": "Если вы только начинаете разбираться с черепашкой, вот 5 команд, которых уже хватает для первых рисунков и базовых заготовок.",
          "italic": true
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Подключение библиотеки"
    },
    {
      "type": "code",
      "text": "from turtle import *"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        [
          {
            "text": "fd(n)",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Идти вперёд на "
          },
          {
            "text": "n",
            "code": true
          }
        ]
      ]
    },
    {
      "type": "code",
      "text": "fd(100)"
    },
    {
      "type": "list",
      "ordered": true,
      "start": 2,
      "items": [
        [
          {
            "text": "bk(n)",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Идти назад на "
          },
          {
            "text": "n",
            "code": true
          }
        ]
      ]
    },
    {
      "type": "code",
      "text": "bk(50)"
    },
    {
      "type": "list",
      "ordered": true,
      "start": 3,
      "items": [
        [
          {
            "text": "rt(a)",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Повернуться направо на "
          },
          {
            "text": "a",
            "code": true
          },
          {
            "text": " градусов"
          }
        ]
      ]
    },
    {
      "type": "code",
      "text": "rt(90)"
    },
    {
      "type": "list",
      "ordered": true,
      "start": 4,
      "items": [
        [
          {
            "text": "lt(a)",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Повернуться налево на "
          },
          {
            "text": "a",
            "code": true
          },
          {
            "text": " градусов"
          }
        ]
      ]
    },
    {
      "type": "code",
      "text": "lt(45)"
    },
    {
      "type": "list",
      "ordered": true,
      "start": 5,
      "items": [
        [
          {
            "text": "goto(x, y)",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Перейти в точку с координатами "
          },
          {
            "text": "(x, y)",
            "code": true
          }
        ]
      ]
    },
    {
      "type": "code",
      "text": "goto(120, -40)"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Пример"
    },
    {
      "type": "code",
      "text": "from turtle import *\n\nfd(100)\nrt(90)\nfd(100)\nlt(90)\ngoto(0, 0)\n\ndone()"
