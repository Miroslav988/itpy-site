      "type": "code",
      "text": "from fnmatch import fnmatch\nfrom itertools import product\n\ns = open('24.txt').readline()\nfor v in product('ABCDEFGHIJKLMNOPQRSTUVWXYZ', repeat=5):\n    slovo = ''.join(v)\n    if fnmatch(slovo, '?B??D'):  \n        s = s.replace(slovo, '**** ****')\nprint(max(len(x) for x in s.split()))"
