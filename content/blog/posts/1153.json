      "text": "Комментарии к коду"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        [
          {
            "text": "from re import *",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Импорт всех функций из модуля re (регулярные выражения)."
          }
        ],
        [
          {
            "text": "for x in range(13, 10**9, 13):",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Цикл, перебирающий числа x от 13 до 1 миллиарда с шагом 13 (т.е. все числа, кратные 13)."
          }
        ],
        [
          {
            "text": "if fullmatch('24[02468]*68[39]35', str(x)):",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Проверяет, соответствует ли строкая запись числа x шаблону:"
          },
          {
            "text": "\n"
          },
          {
            "text": "- 24 – начинается с цифр 24,"
          },
          {
            "text": "\n"
          },
          {
            "text": "- [02468]* – затем любое количество чётных цифр (0, 2, 4, 6, 8),"
          },
          {
            "text": "\n"
          },
          {
            "text": "- 68 – далее идёт 68,"
          },
          {
            "text": "\n"
          },
          {
            "text": "- [39] – после 68 либо 3, либо 9,"
          },
          {
            "text": "\n"
          },
          {
            "text": "- 35 – заканчивается на 35."
          }
        ],
