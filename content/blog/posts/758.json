      "type": "code",
      "text": "def divisors(x):\n    div = []\n    for j in range(1, int(x**0.5)+1):\n        if x % j == 0:\n            div += [j, x // j]\n    return sorted(set(div))\n\n\ncnt = 0\nfor x in range(600_000+1, 10**10):\n    d = [j for j in divisors(x) if j % 10 == 7 and j != 7 and j != x]\n    if len(d) > 0:\n        print(x, min(d))\n        cnt += 1\n        if cnt == 5:\n            break"
    }
