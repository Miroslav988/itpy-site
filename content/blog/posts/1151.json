      "type": "quote",
      "content": [
        {
          "text": "Сколько существует 4-разрядных четверичных чисел, в которых хотя бы одна цифра встречается не менее двух раз?"
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Код решения"
    },
    {
      "type": "code",
      "text": "from itertools import *\ncnt = 0\nfor p in product('0123', repeat=4):\n    num = ''.join(p)\n    if num[0] != '0':\n        if any(num.count(x) >= 2 for x in num):\n            cnt += 1\nprint(cnt)"
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Ответ: 174",
          "bold": true
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Комментарии к коду"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        [
          {
            "text": "from itertools import *",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Импорт всех функций из модуля itertools (используется функция product)"
