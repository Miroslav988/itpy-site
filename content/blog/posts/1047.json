    {
      "type": "code",
      "text": "R = []\nfor n, s in enumerate(open('9.csv'), 1):\n    M = [int(x) for x in s.split(';')]\n    if M == sorted(M):\n        if any(M.count(x) > 1 and sum(map(int, str(x))) % 2 == 0 for x in M):\n            R.append(n)\nprint(max(R))"
    },
