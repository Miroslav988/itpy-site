          "text": "Ход решения номер",
          "bold": true
        },
        {
          "text": " 🚩"
        }
      ]
    },
    {
      "type": "code",
      "text": "s = sorted('БКФЦ')\nprint(s)  # ['Б', 'К', 'Ф', 'Ц']\nn = 0\nfor a in s:\n    for b in s:\n        for c in s:\n            for d in s:\n                for e in s:\n                    slovo = a + b + c + d + e\n                    n += 1\n                    if n == 486:\n                        print(n, slovo)"
    },
