      "text": "from ipaddress import *\nmaxi = []\nfor mask in range(32+1):\n    net = ip_network(f'170.155.137.181/{mask}', 0)\n    if str(net) == f'170.155.136.0/{mask}':\n        maxi.append(int(str(net.netmask).split('.')[2]))\n\nprint(max(maxi))"
