    {
      "type": "heading",
      "level": 2,
      "text": "Код решения"
    },
    {
      "type": "code",
      "text": "import itertools\ncount = 0\nfor s in itertools.product('01234567', repeat=5):\n    slovo = ''.join(s)\n    if slovo[0] != '0':\n        if slovo[0] not in '1357':\n            if slovo[-1] not in '26':\n                if slovo.count('7') <= 2:\n                    count += 1\nprint(count)"
    }
