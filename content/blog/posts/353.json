      "type": "code",
      "text": "for n in range(2, 10000):\n    s = bin(n)[2:]\n\n    chet1 = [x for x in s[1::2] if x == '1']\n    nechet0 = [x for x in s[0::2] if x == '0']\n\n    r = abs(len(chet1) - len(nechet0))\n    if r == 5:\n        print(n)\n        break"
    }
