      "level": 2,
      "text": "Открытие файла"
    },
    {
      "type": "code",
      "text": "file = open(\"example.txt\", \"r\")  # Открываем файл example.txt на чтение"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Чтение содержимого файла"
