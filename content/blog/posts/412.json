      "type": "code",
      "text": "from fnmatch import *\nR = []\nfor x in range(53191, 10**10, 53191):\n    if fnmatch(str(x), '?136*'):\n        if str(x)[0] in '02468' and str(x)[-1] in '13579':\n            R.append([x, x // 53191])\n\n\nfor i in range(-5, 0):\n    print(*R[i])"
    },
