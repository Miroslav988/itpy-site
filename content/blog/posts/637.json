    {
      "type": "heading",
      "level": 2,
      "text": "Код решения"
    },
    {
      "type": "code",
      "text": "alphabet = sorted('0123456789QWERTYUIOPASDFGHJKLZXCVBNM')\ndef convert(num, base):\n    r = ''\n    while num > 0:\n        r += alphabet[num % base]\n        num //= base\n    return r[::-1]\n\n\nR = []\nfor n in range(1, 10000):\n    s = convert(n, 12)\n    if n % 4 == 0:\n        s = '2' + s + '64'\n    else:\n        s += max([x for x in s])\n    r = int(s, 12)\n    if r > 1799:\n        R.append(r)\nprint(min(R))\n\n# Ответ: 1806"
    },
