    {
      "type": "code",
      "text": "def F(a, b, s: str):\n    if a >= b or a == 28:\n        return a == b and 'BACA' not in s\n    return F(a+2, b, s+'A') + F(a+3, b, s+'B') + F(a*2, b, s+'C')\n\n\nprint(F(2, 40, ''))"
    }
