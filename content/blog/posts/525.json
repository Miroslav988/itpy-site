      "type": "heading",
      "level": 2,
      "text": "Код решения"
    },
    {
      "type": "code",
      "text": "def F(x, y, A):\n    return ((y < 20) <= (x > 70)) or (not((x < A) <= (y > A)))\n\nfor A in range(10000):\n    if all(F(x, y, A) for x in range(100) for y in range(100)):\n        print(A)\n        break\n        \n# Ответ: 71"
    },
