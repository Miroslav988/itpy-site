      "level": 2,
      "text": "Код решения"
    },
    {
      "type": "code",
      "text": "alphabet = sorted('0123456789QWERTYUIOPASDFGHJKLZXCVBNM')\ndef convert(num, base):\n    res = ''\n    while num > 0:\n        res = alphabet[num % base] + res\n        num //= base\n    return res\n\n\nR = []\nfor n in range(1, 1000, 2):\n    s = convert(n, 4)\n    if n % 3 == 0:\n        s = s[-1] + s[1:-1] + s[0] + '1'\n    else:\n        s += str(n % 3)\n    r = int(s, 4)\n    if r <= 340:\n        R.append(r)\nprint(max(R))\n\n# Ответ 334"
    },
