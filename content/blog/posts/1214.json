{
  "id": 1214,
  "rubric": "python",
  "description": "Как правильно работать с остатками у отрицательных чисел? В модульной арифметике отрицательные числа дают “обратный” остаток. Например, -14 % 10 → 6, а не 4.",
  "date": "2025-12-01",
  "source": "https://t.me/informatika_kege_itpy/1214",
  "blocks": [
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Как правильно работать с остатками у отрицательных чисел?",
          "bold": true
        },
        {
          "text": "\n"
        },
        {
          "text": "В модульной арифметике отрицательные числа дают"
        },
        {
          "text": " “обратный”",
          "italic": true
        },
        {
          "text": " остаток."
        },
        {
          "text": "\n"
        },
        {
          "text": "Например, "
        },
        {
          "text": "-14 % 10",
          "code": true
        },
        {
          "text": " → "
        },
        {
          "text": "6",
          "bold": true
        },
        {
          "text": ", а не "
        },
        {
          "text": "4",
          "bold": true
        },
        {
          "text": "."
        }
      ]
    },
    {
      "type": "code",
      "text": "print(abs(-14) % 10)  # 4"
    },
    {
      "type": "quote",
      "content": [
        {
          "text": "Поэтому используют модуль, чтобы получать нужный результат."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Как правильно считать длину числа?",
          "bold": true
        },
        {
          "text": "\n"
        },
        {
          "text": "У отрицательного числа в строке появляется минус: "
        },
        {
          "text": "\"-123\"",
          "code": true
        },
        {
          "text": " -- длина "
        },
        {
          "text": "4",
          "bold": true
        },
        {
          "text": ". Поэтому используем "
        },
        {
          "text": "abs()",
          "code": true
        },
        {
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "text": "print(len(str(abs(-123))))  # 3"
    },
    {
      "type": "quote",
      "content": [
        {
          "text": "Модуль убирает знак и даёт корректную длину."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Как правильно использовать ",
          "bold": true
        },
        {
          "text": "zip",
          "code": true
        },
        {
          "text": " для перебора?",
          "bold": true
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "• "
        },
        {
          "text": "Перебор троек:",
          "bold": true
        },
        {
          "text": "\n"
        },
        {
          "text": "for a, b, c in zip(a, a[1:], a[2:]):",
          "code": true
        },
        {
          "text": "\n"
        },
        {
          "text": "Так получается "
        },
        {
          "text": "“скользящее окно”",
          "italic": true
        },
        {
          "text": " из трёх элементов подряд:"
        },
        {
          "text": "\n"
        },
        {
          "text": "(a[0], a[1], a[2]), (a[1], a[2], a[3]) …",
          "code": true
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "• "
        },
        {
          "text": "Перебор пар через одно:",
          "bold": true
        },
        {
          "text": "\n"
        },
        {
          "text": "for a, b in zip(a, a[2:]):",
          "code": true
        },
        {
          "text": "\n"
        },
        {
          "text": "Каждая пара -- это элемент и тот, что стоит через один после него:"
        },
        {
          "text": "\n"
        },
        {
          "text": "(a[0], a[2]), (a[1], a[3]) …",
          "code": true
        }
      ]
    }
  ],
