          {
            "text": "\n"
          },
          {
            "text": "- clustersB[1] - второй кластер (четвертая четверть)"
          },
          {
            "text": "\n"
          },
          {
            "text": "- clustersB[2] - третий кластер (вторая и третья четверти вместе)"
          }
        ],
        [
          {
            "text": "for s in open('27_B.txt'):",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Открываем файл '27_B.txt' для чтения и построчно обрабатываем его содержимое"
