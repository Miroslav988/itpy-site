        [
          {
            "text": "from itertools import permutations",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Импортируем функцию permutations из модуля itertools для генерации всех возможных перестановок элементов."
          }
        ],
        [
          {
            "text": "table = '12 15 16 21 23 24 32 36 37 42 47 51 56 61 63 65 73 74'",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Определяем строку 'table', представляющую набор чисел, разделенных пробелами, которые описывают соединения в графе."
          }
        ],
        [
          {
            "text": "graph = 'AB BA AF FA FB BF FE EF BD DB ED DE EC CE DG GD CG GC'",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Определяем строку 'graph', которая описывает возможные связи между буквами A, B, C, D, E, F, G в графе."
          }
        ],
        [
          {
            "text": "for per in permutations('ABCDEFG'):",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Запускаем цикл, перебирающий все возможные перестановки букв A, B, C, D, E, F, G."
          }
        ],
        [
          {
            "text": "new_table = table",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Создаем копию строки 'table', чтобы постепенно заменять числа на соответствующие буквы из текущей перестановки."
          }
        ],
        [
          {
            "text": "for i in range(1, 7 + 1):",
            "code": true
          },
