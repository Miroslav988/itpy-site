          "text": "\n"
        },
        {
          "text": "# 1 2 3 4 5 6 7"
        },
        {
          "text": "\n"
        },
        {
          "text": "# F E D C A B G"
        },
        {
          "text": "\n"
        },
        {
          "text": "# ED = 53, FB = 2, => 55"
        }
      ]
    },
    {
