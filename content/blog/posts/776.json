      "type": "heading",
      "level": 2,
      "text": "Код решения"
    },
    {
      "type": "code",
      "text": "from ipaddress import *\nnet = ip_network('119.124.96.0/255.255.240.0', 0)\ncnt = 0\nfor ip in net:\n    s = f'{ip:b}'\n    # if s.endswith('0'):\n    if s[-1] == '0':\n        cnt += 1\nprint(cnt)\n\n# Ответ: 2048"
    },
