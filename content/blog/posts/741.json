          }
        ],
        [
          {
            "text": "def F(n):",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Определение функции F с аргументом n."
          }
        ],
        [
          {
            "text": "if n == 1:",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Условие проверки, равно ли значение n единице."
          }
        ],
        [
          {
            "text": "return 1",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Возвращение значения 1, если условие n == 1 истинно."
          }
        ],
        [
          {
            "text": "if n > 1:",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Условие проверки, больше ли значение n единицы."
          }
        ],
        [
          {
            "text": "return 2 * n * F(n-1)",
            "code": true
          },
          {
            "text": "\n"
          },
          {
            "text": "Рекурсивный вызов функции F с аргументом n-1 в случае, если n > 1. Функция возвращает удвоенное произведение n на результат вызова F(n-1)."
          }
