  "blocks": [
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Это строка, содержащая числовые символы, из которых мы будем находить сумму:"
        }
      ]
    },
    {
      "type": "code",
      "text": "s = '12345'"
