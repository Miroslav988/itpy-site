  "blocks": [
    {
      "type": "heading",
      "level": 3,
      "text": "Условие задачи"
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Автомат обрабатывает натуральное число N (0≤N≤255) по следующему алгоритму:"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "1) Строится восьми битная двоичная запись числа N.\n2) Удаляются средние 4 цифры.\n3) Полученное число переводится в десятичную запись и выводится на экран."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Какое наибольшее число, меньшее 110, после обработки автоматом даёт результат 7?"
        }
      ]
    },
    {
      "type": "heading",
      "level": 3,
      "text": "Код решения"
    },
    {
      "type": "image",
      "src": "/blog/zadanie-5-ege-razbor-zadachi-688/01.webp",
      "width": 530,
      "height": 330,
      "alt": "Ответ: 107",
      "caption": "Ответ: 107"
    },
    {
      "type": "heading",
      "level": 3,
      "text": "Комментарии к коду"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        [
          {
            "text": "R = []",
            "code": true
          },
          {
            "text": "\nСоздаем пустой список для хранения подходящих чисел"
          }
        ],
        [
          {
            "text": "for n in range(0, 255+1):",
            "code": true
          },
          {
            "text": "\nНачинаем цикл, перебираем числа от 0 до 255 включительно"
          }
        ],
        [
          {
            "text": "s = f'{n:b}'.zfill(8)",
            "code": true
          },
          {
            "text": "\nПереводим текущее число n в двоичную строку, дополняя нулями до 8 бит (в формате строки)"
          }
        ],
        [
          {
            "text": "s = s[:2] + s[-2:]",
            "code": true
          },
          {
            "text": "\nОставляем только первые две и последние две цифры двоичного представления"
          }
        ],
        [
          {
            "text": "r = int(s, 2)",
            "code": true
          },
          {
            "text": "\nПреобразуем полученную строку обратно в целое число в десятичной системе счисления"
          }
        ],
        [
          {
            "text": "if n < 110 and r == 7:",
            "code": true
          },
          {
            "text": "\nПроверяем, если число меньше 110 и преобразованное число равно 7"
          }
        ],
        [
          {
            "text": "R.append(n)",
            "code": true
          },
          {
            "text": "\nДобавляем число в список R, если оно соответствует условиям"
          }
        ],
        [
          {
            "text": "print(max(R))",
            "code": true
          },
          {
            "text": "\nВыводим наибольшее число из списка R"
          }
        ]
      ]
    }
  ],
  "originalTitle": "Разбор номера 688 #kege по информатике #ЕГЭ5"
}
