          "text": "for m in range(1, 10000):\n    s = '>' + '1' * 15 + '2' * 35 + '3' * m\n\n    while '>1' in s or '>2' in s or '>3' in s:\n        if '>1' in s:\n            s = s.replace('>1', '2>', 1)\n        if '>2' in s:\n            s = s.replace('>2', '3>', 1)\n        if '>3' in s:\n            s = s.replace('>3', '11>', 1)\n\n    summ = sum([int(i) for i in s if i.isdigit()])\n\n    divisors = set()\n    for j in range(2, int(summ**0.5)+1):\n        if summ % j == 0:\n            divisors.add(j)\n            divisors.add(summ // j)\n\n    if len(divisors) == 3:\n        print(m)\n        break"
