          "text": "import itertools\ns = open('24.txt').readline()\nmaxi = 0\nM = []\nfor i in itertools.product('QWERTYUIOPASDFGHJKLZXCVBNM0123456789', repeat = 3):\n    r = ''.join(i)\n    if r[0] in 'NOT' and r[2] in 'NOT':\n        M.append(r)\nfor x in M:\n    s = s.replace(x, ' ')\nmaxi = max([len(i) for i in s.split()])\nprint(maxi)"
