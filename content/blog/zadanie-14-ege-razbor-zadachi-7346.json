        {
          "text": "def my_int(M: list, n: int):\n    r = 0\n    M.reverse()\n    for i in range(0, len(M)):\n        r += M[i] * n ** i\n    return r\n\nfor x in range(0, 67):    \n  A = my_int([3, x, 2, 1], 81)\n  B = my_int([1, 7, x, 4], 67)\n  if (A + B) % 35 == 0:\n    print((A + B) // 35)"
        }
