      "content": [
        {
          "text": "import math as m\nM = [int(i) for i in open('17.txt')]\ncount = 0\nmaxi = 0\nfor i in range(0, len(M)-1):\n    if M[i] % 2 == 0 and M[i+1] % 2 == 0:\n        if m.gcd(M[i], M[i+1]) > 100:\n            count += 1\n            maxi = max(maxi, abs(M[i] - M[i+1]))\nprint(count, maxi)"
        }
