# Settings of the site on the server. install.sh copies this file to ~/itpy/site.env on the first
# run; fill it in there (not here) and run install.sh again.

# The domain without https:// and without www.
DOMAIN=itpy.online
# Absolute addresses on the site (canonical, sitemap, Open Graph).
SITE_URL=https://itpy.online
# Let's Encrypt writes here when a certificate is about to expire. Empty: no certificate yet, the
# site works over plain HTTP until install.sh runs again with it.
CERT_EMAIL=

# Blog: posts and pictures from the channel live outside the repository, so updates of the code
# never touch them. install.sh fills this folder from the repository snapshot.
BLOG_DIR=$HOME/itpy/blog
# Where Telegram is blocked, the HTTP proxy the blog reads the channel through, e.g. a VPN client
# on this server: http://127.0.0.1:10809 (see deploy/server/README.md). Empty: a direct connection.
TELEGRAM_PROXY=
# When the running site checks the channel each day. It also checks a minute after every start,
# and an hour after a failed attempt.
BLOG_SYNC_TIME=04:00
# The clock BLOG_SYNC_TIME is read by.
TZ=Europe/Moscow

# Yandex Metrika counter number (Ilia's counter for itpy.online). Empty: no analytics and no cookie
# banner. Read at build time, so run update.sh after changing it.
NEXT_PUBLIC_METRIKA_ID=114397694

# The site listens here; nginx forwards requests to it. No need to change.
PORT=3000
HOSTNAME=127.0.0.1
