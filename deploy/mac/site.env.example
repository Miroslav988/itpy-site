# Settings of the site on the Mac. install.sh copies this file to ~/itpy/site.env on the first
# run; fill it in there (not here) and run install.sh again.

# The domain without https:// and without www.
DOMAIN=itpy.online
# Absolute addresses on the site (canonical, sitemap, Open Graph).
SITE_URL=https://itpy.online
# Let's Encrypt writes here when a certificate is about to expire.
CERT_EMAIL=

# Blog: posts and pictures from the channel live outside the repository, so updates of the code
# never touch them. install.sh fills this folder from the repository snapshot.
BLOG_DIR=$HOME/itpy/blog
# Telegram is blocked: the blog reads the channel through the HTTP proxy of the VPN client
# (proxy mode, not «all traffic»; see deploy/mac/README.md). Empty means a direct connection.
TELEGRAM_PROXY=http://127.0.0.1:10809
# When the running site checks the channel each day, by the Mac's clock. It also checks a minute
# after every start, and an hour after a failed attempt.
BLOG_SYNC_TIME=04:00

# Yandex Metrika counter number. Empty: no analytics and no cookie banner. Read at build time,
# so run update.sh after changing it.
NEXT_PUBLIC_METRIKA_ID=

# The site listens here; nginx forwards requests to it. No need to change.
PORT=3000
HOSTNAME=127.0.0.1
